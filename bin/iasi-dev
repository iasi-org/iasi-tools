#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
COMMANDS_DIR="$TOOLS_DIR/lib/commands"

usage() {
  cat <<'EOF'
Usage: iasi-dev <command> [options]

Commands:
  clone    Recreate the IASI repositories
  pull     Synchronize repositories with their remote state
  sync     Propagate files from iasi-common to existing copies
  publish  Build, publish, commit, and push Quarto projects
  commit   Commit and push repository changes
  init     Run all IASI initialization steps
  docker   Manage the IASI Docker containers
  help     Show this help or the help for a command

Run 'iasi-dev help <command>' for more information about a command.
EOF
}

if [ "$#" -eq 0 ]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  -h|--help)
    usage
    ;;
  help)
    if [ "$#" -eq 0 ]; then
      usage
    elif [ "$#" -eq 1 ] && [ -x "$COMMANDS_DIR/$1.sh" ]; then
      exec "$COMMANDS_DIR/$1.sh" --help
    else
      printf "iasi-dev: unknown command: %s\n" "${1:-}" >&2
      usage >&2
      exit 2
    fi
    ;;
  clone|pull|sync|publish|commit|init|docker)
    exec "$COMMANDS_DIR/$command.sh" "$@"
    ;;
  *)
    printf "iasi-dev: unknown command: %s\n" "$command" >&2
    usage >&2
    exit 2
    ;;
esac
